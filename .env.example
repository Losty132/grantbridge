# Copy to .env for local runs (VS Code loads it automatically). NEVER commit .env.
# Leave STORAGE_CONN empty to keep data in ./data on your laptop.
STORAGE_CONN=
STORAGE_CONTAINER=ffm-data
LOCAL_DATA_DIR=./data

# Azure OpenAI (optional; the app works without it using rules + TF-IDF similarity)
AOAI_ENDPOINT=
AOAI_KEY=
AOAI_CHAT_DEPLOYMENT=chat
AOAI_EMBED_DEPLOYMENT=embed
AOAI_API_VERSION=2024-10-21

# Azure AI Language PII detection (optional privacy layer 1)
LANGUAGE_ENDPOINT=
LANGUAGE_KEY=

# Agencies in the survey dropdown (profile files in agency_profiles/profiles/)
AGENCIES=all
# Download and parse NOFO PDFs for top results (1 = yes)
NOFO_FETCH=1

# Deadline alerts (optional): a Teams / Slack / Power Automate incoming-webhook URL. Empty = alerts only on the site + calendar file.
ALERT_WEBHOOK_URL=
